75:[["$","title","0",{"children":"Hysteria2 协议是什么？原理、UDP 被限速怎么办与机场清单 | 机场推荐"}],["$","meta","1",{"name":"description","content":"Hysteria2 是把速度赌在 UDP 上的协议，靠 Brutal 拥塞控制抢带宽，丢包网络里更快，也最容易被运营商 QoS 掉住。讲清原理、官方的两个对策（端口跳跃与 Mimic 不能同时用）、哪些客户端支持、常见报错对照，以及本站核实过在用它的 16 家机场。"}],["$","link","2",{"rel":"canonical","href":"/hysteria2"}],["$","meta","3",{"property":"og:title","content":"Hysteria2 协议是什么？原理、UDP 被限速怎么办与机场清单 | 机场推荐"}],["$","meta","4",{"property":"og:description","content":"Hysteria2 是把速度赌在 UDP 上的协议，靠 Brutal 拥塞控制抢带宽，丢包网络里更快，也最容易被运营商 QoS 掉住。讲清原理、官方的两个对策（端口跳跃与 Mimic 不能同时用）、哪些客户端支持、常见报错对照，以及本站核实过在用它的 16 家机场。"}],["$","meta","5",{"property":"og:url","content":"/hysteria2"}],["$","meta","6",{"property":"og:site_name","content":"机场推荐"}],["$","meta","7",{"property":"og:locale","content":"zh_CN"}],["$","meta","8",{"property":"og:image","content":"/opengraph-image?3283ab2aa85415f6"}],["$","meta","9",{"property":"og:image:type","content":"image/png"}],["$","meta","10",{"property":"og:image:width","content":"1200"}],["$","meta","11",{"property":"og:image:height","content":"630"}],["$","meta","12",{"property":"og:image:alt","content":"机场推荐 - VPN翻墙科学上网梯子测评"}],["$","meta","13",{"property":"og:type","content":"website"}],["$","meta","14",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","15",{"name":"twitter:title","content":"Hysteria2 协议是什么？原理、UDP 被限速怎么办与机场清单 | 机场推荐"}],["$","meta","16",{"name":"twitter:description","content":"Hysteria2 是把速度赌在 UDP 上的协议，靠 Brutal 拥塞控制抢带宽，丢包网络里更快，也最容易被运营商 QoS 掉住。讲清原理、官方的两个对策（端口跳跃与 Mimic 不能同时用）、哪些客户端支持、常见报错对照，以及本站核实过在用它的 16 家机场。"}],["$","meta","17",{"name":"twitter:image","content":"/opengraph-image?3283ab2aa85415f6"}],["$","meta","18",{"name":"twitter:image:alt","content":"机场推荐 - VPN翻墙科学上网梯子测评"}],["$","meta","19",{"name":"twitter:image:type","content":"image/png"}],["$","meta","20",{"name":"twitter:image:width","content":"1200"}],["$","meta","21",{"name":"twitter:image:height","content":"630"}],["$","link","22",{"rel":"icon","href":"/icon