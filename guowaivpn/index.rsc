2a:["$","div",null,{"className":"mt-12 border-2 border-foreground p-6","children":[["$","h2",null,{"className":"font-serif text-2xl font-semibold tracking-tight","children":"想在中国大陆稳定翻墙？"}],["$","p",null,{"className":"mt-3 leading-7 text-muted","children":["国外VPN的强项在海外场景；中国大陆翻墙看「连通率 + 是否持续对抗GFW」，抗审查协议的机场才是对症选择。从"," ",["$","$L5",null,{"href":"/","className":"text-accent underline underline-offset-2 hover:no-underline","children":"机场推荐首页"}]," ","按需求筛选，或直接看"," ",["$","$L5",null,{"href":"/pianyijichang","className":"text-accent underline underline-offset-2 hover:no-underline","children":"便宜机场推荐"}],"；防坑方法论见"," ",["$","$L5",null,{"href":"/fangpian","className":"text-accent underline underline-offset-2 hover:no-underline","children":"防骗指南"}],"。"]}]]}]
