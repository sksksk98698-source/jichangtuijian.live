63:["$","p",null,{"className":"my-5 leading-8 text-foreground/85","children":[["$","$1","0",{"children":["$","strong",null,{"className":"font-semibold text-foreground","children":"核实日期"}]}],["$","$1","1",{"children":"：2026 年 8 月 31 日。五个等级 30 档的价格、流量、设备数与峰值速率，三个优惠码的折后金额与适用范围，79 个节点的地区、倍率与在线人数，购买须知与支付活动原文，客户端与订阅格式清单，均来自登录账号后从用户面板一手读取；七个域名的分工与到期时间来自逐个实测与注册局记录。速度、流媒体与 AI 解锁本站未实测，套餐说明中亦无相关承诺，文中已逐项标注来源。"}]]}]
