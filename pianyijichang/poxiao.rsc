17:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BlogPosting\",\"headline\":\"云通机场改名破晓：官网、套餐、优惠码与余额都去哪了\",\"description\":\"云通机场跑路了吗？没有——2026 年 7 月它换牌成了「破晓」。本站登录后台核实：破晓六个入口今天全部可用、四档套餐 ¥19.9/月起。但计费从云通的按量不过期改成了包月清零，老用户余额转成了套餐抵扣。文内给全六个入口与完整套餐表，并附云通官方频道那条「用户提现排在个人还款之后」的原话。\",\"datePublished\":\"2026-09-04\",\"dateModified\":\"2026-09-04\",\"url\":\"/pianyijichang/poxiao\",\"inLanguage\":\"zh-Hans\",\"author\":{\"@type\":\"Organization\",\"name\":\"机场推荐\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"机场推荐\"}}"}}]
