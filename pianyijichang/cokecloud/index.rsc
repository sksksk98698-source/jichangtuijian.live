4a:["$","ul",null,{"className":"my-5 list-disc space-y-2 pl-6 text-foreground/85 marker:text-accent","children":["\n",["$","li",null,{"className":"leading-7","children":"涨价理由：「近期整体网络环境持续收紧，线路、服务器、带宽、IP 资源以及网络维护等方面的长期投入也在不断增加」"}],"\n",["$","li",null,{"className":"leading-7","children":[["$","$1","0",{"children":"生效时间："}],["$","$1","1",{"children":["$","strong",null,{"className":"font-semibold text-foreground","children":"2026 年 9 月 1 日起，对目前在售套餐启用新的价格体系"}]}]]}],"\n",["$","li",null,{"className":"leading-7","children":[["$","$1","0",{"children":"缓冲期："}],["$","$1","1",{"children":["$","strong",null,{"className":"font-semibold text-foreground","children":"8 月 31 日 23:59 之前，在售套餐仍按现价执行"}]}],["$","$1","2",{"children":"，且可正常使用补偿优惠券"}]]}],"\n",["$","li",null,{"className":"leading-7","children":[["$","$1","0",{"children":"对老用户："}],["$","$1","1",{"children":["$","strong",null,{"className":"font-semibold text-foreground","children":"已购买并正在使用的套餐不受影响"}]}],["$","$1","2",{"children":"，有效期、剩余流量、权益均不变；新价格在后续新购或续费时生效"}]]}],"\n",["$","li",null,{"className":"leading-7","children":[["$","$1","0",{"children":"新价格具体是多少："}],["$","$1","1",{"children":["$","strong",null,{"className":"font-semibold text-foreground","children":"公告没写"}]}],["$","$1","2",{"children":"，只说「以届时购买页面显示为准」"}]]}],"\n"]}]
4b:["$","p",null,{"className":"my-5 leading-8 text-foreground/85","children":[["$","$1","0",{"children":"官方在公告里给的理由是「相比单纯维持更低的价格，我们更希望能够保证服务可以长期、稳定地运行」。"}],["$","$1","1",{"children":["$","strong",null,{"className":"font-semibold text-foreground","children":"提前半个月预告涨价、而不是改完价再通知，这个做法本身是加分的"}]}],["$","$1","2",{"children":"——机场行业里悄悄改价的更多。"}]]}]
4c:["$","p",null,{"className":"my-5 leading-8 text-foreground/85","children":[["$","$1","0",{"children":"但读者要清楚的是："}],["$","$1","1",{"children":["$","strong",null,{"className":"font-semibold text-foreground","children":"涨多少、哪些档涨，现在没人知道"}]}],["$","$1","2",{"children":"，包括本文。所以任何「赶紧上车锁定低价」的说法都得打个折——你锁定的是一个已知的价，赌的是未知的涨幅，而这中间还夹着一家刚经历过服务波动的机场。"}]]}]
4d:[false,["$","h2",null,{"id":"4-6-月那次波动-官方认了-但也别只算在它头上","className":"mt-12 mb-4 scroll-mt-28 border-b border-rule pb-2 font-serif text-2xl font-semibold tracking-tight lg:scroll-mt-20","children":"4-6 月那次波动:官方认了,但也别只算在它头上"}]]
4e:["$","p",null,{"className":"my-5 leading-8 text-foreground/85","children":"公告里这段写得比较实在，摘其大意：今年 4 月开始整体网络环境不断变化，先后经历线路波动、部分网络资源受限和各种突发情况，很多问题不是加几台服务器就能解决，只能不断调整线路、入口和网络架构；这段时间确实给部分用户带来了不好的体验，不希望用客观原因简单带过。"}]
