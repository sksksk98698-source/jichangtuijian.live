65:[["$","title","0",{"children":"VLESS 协议是什么？它本身不加密，安全吗看外面那层 | 机场推荐"}],["$","meta","1",{"name":"description","content":"VLESS 是什么？Xray 官方写明它是「无状态的轻量传输协议」，而且必须配合传输安全层使用——它自己不加密。所以「VLESS 安全吗」要看外面套的是 TLS 还是 Reality。本文讲清它和 VMess 的区别、「被弃用」是怎么传出来的，以及为什么 Clash for Windows 打不开 VLESS 节点。"}],["$","link","2",{"rel":"canonical","href":"/vless"}],["$","meta","3",{"property":"og:title","content":"VLESS 协议是什么？它本身不加密，安全吗看外面那层 | 机场推荐"}],["$","meta","4",{"property":"og:description","content":"VLESS 是什么？Xray 官方写明它是「无状态的轻量传输协议」，而且必须配合传输安全层使用——它自己不加密。所以「VLESS 安全吗」要看外面套的是 TLS 还是 Reality。本文讲清它和 VMess 的区别、「被弃用」是怎么传出来的，以及为什么 Clash for Windows 打不开 VLESS 节点。"}],["$","meta","5",{"property":"og:url","content":"/vless"}],["$","meta","6",{"property":"og:site_name","content":"机场推荐"}],["$","meta","7",{"property":"og:locale","content":"zh_CN"}],["$","meta","8",{"property":"og:image","content":"/opengraph-image?3283ab2aa85415f6"}],["$","meta","9",{"property":"og:image:type","content":"image/png"}],["$","meta","10",{"property":"og:image:width","content":"1200"}],["$","meta","11",{"property":"og:image:height","content":"630"}],["$","meta","12",{"property":"og:image:alt","content":"机场推荐 - VPN翻墙科学上网梯子测评"}],["$","meta","13",{"property":"og:type","content":"website"}],["$","meta","14",{"name":"twitter:card","content":"summary_large_image"}],["$","meta","15",{"name":"twitter:title","content":"VLESS 协议是什么？它本身不加密，安全吗看外面那层 | 机场推荐"}],["$","meta","16",{"name":"twitter:description","content":"VLESS 是什么？Xray 官方写明它是「无状态的轻量传输协议」，而且必须配合传输安全层使用——它自己不加密。所以「VLESS 安全吗」要看外面套的是 TLS 还是 Reality。本文讲清它和 VMess 的区别、「被弃用」是怎么传出来的，以及为什么 Clash for Windows 打不开 VLESS 节点。"}],["$","meta","17",{"name":"twitter:image","content":"/opengraph-image?3283ab2aa85415f6"}],["$","meta","18",{"name":"twitter:image:alt","content":"机场推荐 - VPN翻墙科学上网梯子测评"}],["$","meta","19",{"name":"twitter:image:type","content":"image/png"}],["$","meta","20",{"name":"twitter:image:width","content":"1200"}],["$","meta","21",{"name":"twitter:image:height","content":"63