server {
    listen 80;
    listen [::]:80;
    server_name jichangtuijian.family www.jichangtuijian.family;
    return 301 https://jichangtuijian.family$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.jichangtuijian.family;
    # ssl_certificate /path/to/fullchain.pem;
    # ssl_certificate_key /path/to/privkey.pem;
    return 301 https://jichangtuijian.family$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name jichangtuijian.family;

    # ssl_certificate /path/to/fullchain.pem;
    # ssl_certificate_key /path/to/privkey.pem;

    root /var/www/jichangtuijian.family;
    index index.html;

    # 安全响应头与 SEO 优化
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Gzip 压缩
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml image/svg+xml text/x-component font/woff2;

    # 静态资源长期不可变缓存
    location /_next/static/ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # 搜索接口
    location = /api/search-index {
        default_type application/json;
        try_files /api/search-index.json =404;
    }

    # 站点地图与机器人协议
    location = /sitemap.xml {
        default_type application/xml;
        try_files /sitemap.xml =404;
    }

    location = /robots.txt {
        default_type text/plain;
        try_files /robots.txt =404;
    }

    # 静态路由支持
    location / {
        try_files $uri $uri/ $uri.html /index.html;
    }
}
