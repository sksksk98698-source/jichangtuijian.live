2e:["$","div",null,{"className":"mt-4 flex flex-col","children":[["$","div","iplc/hkbeup",{"className":"border-t border-rule py-6","children":[["$","div",null,{"className":"flex flex-wrap items-baseline justify-between gap-x-4","children":[["$","h3",null,{"className":"font-serif text-xl font-semibold","children":["$","$L5",null,{"href":"/iplc/hkbeup","className":"text-accent underline underline-offset-2 hover:no-underline","children":"HK-BEUP"}]}],["$","span",null,{"className":"text-sm text-muted","children":["¥25/月起 · 200G/月","　·　每 GB ¥0.033"]}]]}],["$","p",null,{"className":"mt-2 leading-7 text-muted","children":"站点做得相当正规——试用档、工单、文档中心、线路自检、节点地图、订阅动态验证码、面向企业的专线定制都有。十二档套餐里藏着一个反直觉的结论：名叫「影视套餐」的 Media 档每 GB 只要 3.3 分，比旗舰 Max 年付还低三成，流量、速率、设备数却全面更高。但两件事要先知道：控制台自报的「稳定运营 1792 天」是前端硬编码起点、比最早域名还早 517 天；官网与官方邀请域在国内都已被 DNS 污染。"}]]}],["$","div","iplc/tansuozhe",{"className":"border-t border-rule py-6","children":[["$","div",null,{"className":"flex flex-wrap items-baseline justify-between gap-x-4","children":[["$","h3",null,{"className":"font-serif text-xl font-semibold","children":["$","$L5",null,{"href":"/iplc/tansuozhe","className":"text-accent underline underline-offset-2 hover:no-underline","children":"探索者"}]}],["$","span",null,{"className":"text-sm text-muted","children":["¥8.17/月起 · 60G/月","　·　每 GB ¥0.063"]}]]}],["$","p",null,{"className":"mt-2 leading-7 text-muted","children":"运营可回溯到 2021 年底的老牌机场，主打 IEPL 内网专线与 US9929 AI 专线，自研 Windows 客户端、教程齐全。最大的门槛是五档套餐全部没有月付，最低要一次付半年或一年；半年付乘二正好等于年付，压长周期一分钱不省。「IEPL 专线」也不是每档都给——最低两档实际上拿不到。"}]]}],["$","div","iplc/galaxycloud",{"className":"border-t border-rule py-6","children":[["$","div",null,{"className":"flex flex-wrap items-baseline justify-between gap-x-4","children":[["$","h3",null,{"className":"font-serif text-xl font-semibold","children":["$","$L5",null,{"href":"/iplc/galaxycloud","className":"text-accent underline underline-offset-2 hover:no-underline","children":"银河云"}]}],["$","span",null,{"className":"text-sm text-muted","children":["¥18/月起 · 100G/月","　·　每 GB ¥0.105"]}]]}],["$","p",null,{"className":"mt-2 leading-7 text-muted","children":"银河云（Galaxy Cloud）是一家自称全 IPLC 专线的机场，面板里最早三档套餐建于 2023 年 6 月底。六档价格全部从公开接口一手读回：星尘 100G 月付 18 元、行星 200G 月付 35 元、恒星 400G 月付 70 元、星系 800G 月付 140 元，另有 98 元起的轻量年付礼包和 680 元的 1T 永久流量包。最值得先知道的一条是：行星、恒星、星系三档的每 GB 单价在每个周期上完全相同（月付 0.175 元、年付 0.140 元、三年付 0.105 元），升档只买到总量、买不到更低单价；而 1T 永久包每 GB 0.68 元，是三年付的 6.5 倍，多付的钱买的是「不过期」。折扣阶梯是真的（季 9 折、半年 85 折、年 8 折、两年 7 折、三年 6 折），但官方套餐文案把档位名写错了。跑路名单查无此名，五个域名实测同属一套后端；注册页那条「服务条款」是空链接，站上没有可读的条款与退款口径。节点、速度、流媒体解锁本文一项未实测。"}]]}],["$","div","iplc/sntp",{"className":"border-t border-rule py-6","children":[["$","div",null,{"className":"flex flex-wrap items-baseline justify-between gap-x-4","children":[["$","h3",null,{"className":"font-serif text-xl font-semibold","children":["$","$L5",null,{"href":"/iplc/sntp","className":"text-accent underline underline-offset-2 hover:no-underline","children":"守候网络（SNTP）"}]}],["$","span",null,{"className":"text-sm text-muted","children":["¥18/月起 · 100G/月","　·　每 GB ¥0.077"]}]]}],["$","p",null,{"className":"mt-2 leading-7 text-muted","children":"中文名守候网络，面板与客户端上的官方名字是 SNTP。这篇的价格全部来自注册账号登录后台读取用户面板接口：在售五档，Lite Connect 100GB 月付 18 元、Core Essentials 200GB 28 元、Plus Advantage 350GB 38 元、Max Infinity 500GB 48 元，四档折扣结构完全一致（季付约 9 折、半年付 85 折、年付 8 折）；最高的 Premium 1000GB／8 台设备则只卖年付 968 元，月付、季付、半年付字段全空。值得先讲的一条是它的官网入口：后台挂着一份「关于近期各类诈骗的公告」，明写只有两个发布页公布的入口是官方，其余自称 SNTP 官网的链接均为假冒——照着搜索结果实测，一个页面标题写着「守候网络（SNTP）」的站点，点「注册」会经短链跳到另一家机场带推广参数的注册页。另外订阅拉取被限制为仅允许中国大陆 IP。节点、速度、流媒体解锁本站一项未测。"}]]}],["$","div","iplc/fliggycloud",{"className":"border-t border-rule py-6","children":[["$","div",null,{"className":"flex flex-wrap items-baseline justify-between gap-x-4","children":[["$","h3",null,{"className":"font-serif text-xl font-semibold","children":["$","$L5",null,{"href":"/iplc/fliggycloud","className":"text-accent underline underline-offset-2 hover:no-underline","children":"飞天猪"}]}],"$L30"]}],"$L31"]}],"$L32","$L33","$L34","$L35","$L36"]}]
