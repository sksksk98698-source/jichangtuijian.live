18:["$","script",null,{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BlogPosting\",\"headline\":\"XLM Cloud跑了吗?没跑,但你手上那个官网地址多半已经作废了\",\"description\":\"XLM Cloud(ixlmo)跑路了吗?没有。官方 Telegram 频道 2026 年 8 月仍在更新,官网国内可直连。跑路监测库里那条 2025 年 11 月的立案属实,但同一条下有用户回复「正常,可以用」——那是一次波及永久套餐的事故。你打不开官网,是因为它三年里换过四个主域,你手上的是旧地址。四档实价与每 GB 单价核算见正文:最划算的那档叫「游戏套餐」。\",\"datePublished\":\"2026-08-20\",\"dateModified\":\"2026-08-20\",\"url\":\"/iplc/xlmcloud\",\"inLanguage\":\"zh-Hans\",\"author\":{\"@type\":\"Organization\",\"name\":\"机场推荐\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"机场推荐\"}}"}}]
