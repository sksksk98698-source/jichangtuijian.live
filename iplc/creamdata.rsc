39:["$","p",null,{"className":"my-5 leading-8 text-foreground/85","children":[["$","$1","0",{"children":["$","strong",null,{"className":"font-semibold text-foreground","children":"铁律"}]}],["$","$1","1",{"children":":① 进过跑路预警名单的机场,只短期小额、别碰长期;② 官网打不开不等于跑路,先分清是「大陆真进不去」还是「开代理才打不开」+ 认准备用域名;③ "}],["$","$1","2",{"children":["$","strong",null,{"className":"font-semibold text-foreground","children":"同源线路出事时别在同门里找避风港"}]}],["$","$1","3",{"children":"(唯云四杰近期集体动荡就是教训);④ 永远备一个体系外的替代。"}]]}]
